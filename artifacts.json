{
  "$comment": "Which GitHub Release asset to take from each repo, and where its files land under out/staging/<id>/. By default the repo's latest release (drafts and pre-releases excluded) is used; set 'tag' on a component to pin it, e.g. \"tag\": \"v1.2.0\". 'asset' is the zip name, with {repo}, {tag} and {version} (the tag without its leading 'v') filled in; a component can set its own 'asset' when its zip is named differently. In 'files', 'from' is a glob relative to the zip root (* = one path segment, ** = any depth); 'to' ending in '/' (or empty) is a folder, otherwise the single match is renamed to that file name; 'keepTree' keeps the sub-path below the glob's fixed prefix instead of flattening.",
  "owner": "Ramesh-Mokkapati",
  "asset": "{repo}-{tag}-x64.zip",
  "exclude": [ "**/*.pdb", "**/*.ilk", "**/*.exp", "**/*.lib", "**/*.iobj", "**/*.ipdb" ],
  "components": [
    {
      "id": "AppFramework",
      "repo": "Application-Framework",
      "files": [
        { "from": "bin/*", "to": "" },
        { "from": "README.md", "to": "" }
      ]
    },
    {
      "id": "AzureIoT",
      "repo": "Azure-IoT-SDK-CPP",
      "files": [
        { "from": "*.exe", "to": "" },
        { "from": "*.dll", "to": "", "optional": true }
      ]
    },
    {
      "id": "DefragLens",
      "repo": "DefragLens",
      "asset": "{repo}-{tag}.zip",
      "files": [
        { "from": "x64/DefragLens.exe", "to": "" },
        { "from": "x64/DefragLensBoot.exe", "to": "" }
      ]
    },
    {
      "id": "DiskForge",
      "repo": "DiskForge",
      "files": [
        { "from": "DiskForge.exe", "to": "" }
      ]
    },
    {
      "id": "FileUnlocker",
      "repo": "FileUnlocker",
      "files": [
        { "from": "FileUnlocker.exe", "to": "" }
      ]
    },
    {
      "id": "FindFiles",
      "repo": "Find-Files",
      "asset": "FindFiles-{version}-x64.zip",
      "files": [
        { "from": "FindFiles.exe", "to": "" }
      ]
    },
    {
      "id": "Localisation",
      "repo": "Localisation",
      "files": [
        { "from": "CommandLine.exe", "to": "" },
        { "from": "DialogApp.exe", "to": "" },
        { "from": "SDIApp.exe", "to": "" },
        { "from": "EnglishDLL.dll", "to": "" },
        { "from": "FrenchDLL.dll", "to": "" },
        { "from": "GermanDLL.dll", "to": "" }
      ]
    },
    {
      "id": "MemPurge",
      "repo": "MemPurge",
      "files": [
        { "from": "MemPurge.exe", "to": "" }
      ]
    },
    {
      "id": "Messaging",
      "repo": "Messaging",
      "files": [
        { "from": "**/*", "to": "", "keepTree": true }
      ]
    },
    {
      "id": "MfcSqLite",
      "repo": "MfcSqLite",
      "files": [
        { "from": "MfcSqliteApp.exe", "to": "" }
      ]
    },
    {
      "id": "Porting",
      "repo": "Porting",
      "files": [
        { "from": "x86/*", "to": "x86/" },
        { "from": "x64/*", "to": "x64/" }
      ]
    },
    {
      "id": "RBTray",
      "repo": "RBTrayPlusPlus",
      "asset": "RBTray++-{version}-x64.zip",
      "files": [
        { "from": "RBTray++.exe", "to": "" },
        { "from": "RBHook.dll", "to": "" }
      ]
    },
    {
      "id": "RecoverAside",
      "repo": "RecoverAside",
      "asset": "{repo}-{version}-x64.zip",
      "files": [
        { "from": "RecoverAside.exe", "to": "" }
      ]
    },
    {
      "id": "RegistryCleaner",
      "repo": "RegistryCleaner",
      "files": [
        { "from": "RegistryCleaner.exe", "to": "" }
      ]
    },
    {
      "id": "StartupManager",
      "repo": "StartupManager",
      "files": [
        { "from": "StartupManager.exe", "to": "" }
      ]
    },
    {
      "id": "UpdateInspector",
      "repo": "UpdateInspector",
      "files": [
        { "from": "UpdateInspector.exe", "to": "" }
      ]
    },
    {
      "id": "UpdateManagers",
      "repo": "UpdateManagers",
      "files": [
        { "from": "UpdateManager-Push.exe", "to": "" },
        { "from": "UpdateManager-Pull.exe", "to": "" }
      ]
    },
    {
      "id": "WipeTrace",
      "repo": "WipeTrace",
      "asset": "{repo}-{version}-x64.zip",
      "files": [
        { "from": "WipeTrace.exe", "to": "" }
      ]
    }
  ]
}
